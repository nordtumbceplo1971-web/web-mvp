# ===== 上游 API 配置（优创AIGC 开放 API）=====
# Base URL 见《上游API文档.md》
UPSTREAM_BASE_URL=https://121481.token6688.com
# 填写 sk- 密钥后自动切换为真实调用；留空则运行在 MOCK 演示模式（不产生任何费用）
UPSTREAM_API_KEY=

# ===== 模型配置（与上游文档模型清单对应）=====
MODEL_IMAGE_PRIMARY=gpt-image-2.5-flare
MODEL_IMAGE_SECONDARY=gpt-image-2.5-sunburst
MODEL_VIDEO=veo-4-omni
MODEL_TEXT=glm-5.3-flash

# ===== 服务配置 =====
PORT=8787
CORS_ORIGIN=http://localhost:5173

# ===== 登录鉴权（单一访问码）=====
# 留空 = 鉴权关闭 (本地开发 / MOCK 演示)；配置后 /api 全部要求登录,
# 前端会显示访问码登录页; 更换此值即吊销所有已签发的登录态 (30 天有效期)
ACCESS_CODE=
