# ===== 上游 API 配置（优创AIGC 开放 API）=====
# Base URL 见《上游API文档.md》
UPSTREAM_BASE_URL=https://121481.token6688.com
# 填写 sk- 密钥后自动切换为真实调用；留空则运行在 MOCK 演示模式（不产生任何费用）
UPSTREAM_API_KEY=

# ===== 模型配置（与上游文档模型清单对应）=====
MODEL_IMAGE_PRIMARY=gpt-image-2.5-flare
MODEL_IMAGE_SECONDARY=gpt-image-2.5-sunburst
MODEL_VIDEO=veo-4-omni
MODEL_TEXT=glm-5.3-flash

# ===== 服务配置 =====
PORT=8787
CORS_ORIGIN=http://localhost:5173

# ===== 登录鉴权（单一访问码）=====
# 留空 = 鉴权关闭 (本地开发 / MOCK 演示)；配置后 /api 全部要求登录,
# 前端会显示访问码登录页; 更换此值即吊销所有已签发的登录态 (30 天有效期)
ACCESS_CODE=

# ===== 内置种子账号 (启动时幂等创建) =====
# 格式: "user1:pass1,user2:pass2" — 密码不进 git, 仅写在 .env
SEED_USERS=

# ===== 注册开关 =====
# '1' = 开放邮箱注册; 缺省/留空 = 关闭 (登录页隐藏注册入口, 注册接口返回 403)
REGISTER_ENABLED=

# ===== 邮箱账号体系（SMTP 发信, 网易企业邮）=====
# 未配置 SMTP 时: 注册验证码仅打印到后端日志 (生产环境必须配置才能真正发信)
# 注册接口同时校验 ACCESS_CODE 作为注册邀请码, 防陌生人灌号
SMTP_HOST=smtphz.qiye.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 注册邮箱白名单域名 (逗号分隔); 空 = 不限, 不推荐
REGISTER_DOMAIN=
